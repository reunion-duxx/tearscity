<Project Sdk="Godot.NET.Sdk/4.5.1">
    <PropertyGroup>
       
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>true</ImplicitUsings>
        <LangVersion>13.0</LangVersion>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    
        <Sts2Dir>C:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2</Sts2Dir>
        <Sts2DataDir>$(Sts2Dir)\data_sts2_windows_x86_64</Sts2DataDir>

  
        <RitsuLibDir>C:\Program Files (x86)\Steam\steamapps\workshop\content\2868840\3747602295</RitsuLibDir>
        <RitsuLibCompatVersion>0.113.0</RitsuLibCompatVersion>

     
        <DeployMod Condition="'$(DeployMod)' == ''">true</DeployMod>
    </PropertyGroup>

    <ItemGroup>
      
        <Reference Include="sts2">
            <HintPath>$(Sts2DataDir)\sts2.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <Reference Include="0Harmony">
            <HintPath>$(Sts2DataDir)\0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <Reference Include="STS2-RitsuLib">
            <HintPath>$(RitsuLibDir)\compat\$(RitsuLibCompatVersion)\STS2-RitsuLib.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="STS2-RitsuLib.Runtime">
            <HintPath>$(RitsuLibDir)\compat\$(RitsuLibCompatVersion)\STS2-RitsuLib.Runtime.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="STS2-RitsuLib.Shared">
            <HintPath>$(RitsuLibDir)\shared\STS2-RitsuLib.Shared.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>


    <ItemGroup>
        <!-- 运行时从磁盘直接读的资源（音频等），不进 pck，原样复制到 mod 目录 -->
        <ModAsset Include="assets\**\*" />
    </ItemGroup>

    <Target Name="Stage Mod" AfterTargets="Build">
        <Message Text="Staging mod files to dist\$(MSBuildProjectName)\ ..." Importance="high" />
        <MakeDir Directories="$(MSBuildProjectDirectory)\dist\$(MSBuildProjectName)\" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)\dist\$(MSBuildProjectName)\" />
        <Copy SourceFiles="$(MSBuildProjectName).json" DestinationFolder="$(MSBuildProjectDirectory)\dist\$(MSBuildProjectName)\" />
        <Copy SourceFiles="$(MSBuildProjectName).pck" DestinationFolder="$(MSBuildProjectDirectory)\dist\$(MSBuildProjectName)\" Condition="Exists('$(MSBuildProjectName).pck')" />
        <Copy SourceFiles="@(ModAsset)"
              DestinationFiles="@(ModAsset->'$(MSBuildProjectDirectory)\dist\$(MSBuildProjectName)\assets\%(RecursiveDir)%(Filename)%(Extension)')"
              Condition="'@(ModAsset)' != ''" />
    </Target>


    <Target Name="Copy Mod" AfterTargets="Stage Mod" Condition="'$(DeployMod)' == 'true'">
        <Message Text="Copying mod to Slay the Spire 2 mods folder..." Importance="high" />
        <MakeDir Directories="$(Sts2Dir)\mods\$(MSBuildProjectName)\" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(Sts2Dir)\mods\$(MSBuildProjectName)\" />
        <Copy SourceFiles="$(MSBuildProjectName).json" DestinationFolder="$(Sts2Dir)\mods\$(MSBuildProjectName)\" />
        <Copy SourceFiles="$(MSBuildProjectName).pck" DestinationFolder="$(Sts2Dir)\mods\$(MSBuildProjectName)\" Condition="Exists('$(MSBuildProjectName).pck')" />
        <Copy SourceFiles="@(ModAsset)"
              DestinationFiles="@(ModAsset->'$(Sts2Dir)\mods\$(MSBuildProjectName)\assets\%(RecursiveDir)%(Filename)%(Extension)')"
              Condition="'@(ModAsset)' != ''" />
    </Target>
</Project>
